[Unit]
Description=Clipboard history store for cliphist (feeds `cliphist list`)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/wl-paste --no-newline --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
