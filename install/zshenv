# zsh reads /etc/zsh/zshenv before any $ZDOTDIR rc files. Point ZDOTDIR at
# ~/.config/zsh so zsh then auto-loads ~/.config/zsh/.zshrc (a dotted startup
# file in ZDOTDIR is picked up automatically). A plain `zshrc` would NOT be
# auto-loaded and would trip zsh's first-run wizard, so the file is named
# `.zshrc`. zsh only sources .zshrc for interactive shells, so prompt/keymap
# setup never leaks into scripts (`zsh -c '...'`, cron, etc).
export ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
