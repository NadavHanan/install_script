# btrbk remote-target helper. All empty => local snapshots only.
# Edit to enable remote backups; also uncomment the matching target block in
# /etc/btrbk/btrbk.conf. See install/POST_INSTALL.md -> "Backups (btrbk)".

# SSH server (home LAN) used only to probe reachability before rsync.
# Must match the ssh_uri in btrbk.conf.
BACKUP_SSH_HOST=""

# btrfs USB backup device mounted here (checked with `mountpoint`).
BACKUP_USB_DIR=""

# rsync destination for the small config files (/var/lib/iwd, /var/lib/bluetooth,
# and the explicit-package list).  SSH:  user@host:/path   USB:  /mount/path
MISC_DEST=""
