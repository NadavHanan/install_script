#!/usr/bin/env bash
# screenshot — pick a window/monitor/free area, save to ~/Pictures + clipboard.
# click (tiny drag) = window under cursor (monitor if none), drag = free area.
set -e
out="$HOME/Pictures/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

ws=$(hyprctl -j monitors | jq -r '.[]|select(.focused)|.activeWorkspace.id')
# Windows first: the click fallback picks the first containing rect.
rects=$(
    { hyprctl -j clients  | jq -r --argjson w "$ws" '.[]|select(.workspace.id==$w)|"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
      hyprctl -j monitors | jq -r --argjson w "$ws" '.[]|select(.activeWorkspace.id==$w)|"\(.x),\(.y) \(.width)x\(.height)"'; }
)
sel=$(echo "$rects" | slurp)

# Tiny drag (<20px²) = click: snap to first containing rect (window, else monitor).
if [[ $sel =~ ^([0-9]+),([0-9]+)\ ([0-9]+)x([0-9]+)$ ]] && ((BASH_REMATCH[3] * BASH_REMATCH[4] < 20)); then
    cx=${BASH_REMATCH[1]} cy=${BASH_REMATCH[2]}
    for r in $rects; do
        [[ $r =~ ^([0-9]+),([0-9]+)\ ([0-9]+)x([0-9]+)$ ]] || continue
        ((cx >= BASH_REMATCH[1] && cx < BASH_REMATCH[1] + BASH_REMATCH[3] \
            && cy >= BASH_REMATCH[2] && cy < BASH_REMATCH[2] + BASH_REMATCH[4])) \
            && sel=$r && break
    done
fi

grim -g "$sel" "$out"
wl-copy <"$out"
