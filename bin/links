#!/usr/bin/env bash
# links — open a URL from ~/Documents/md_files/links (lines: label:url)
set -euo pipefail

FILE="${LINKS_FILE:-$HOME/Documents/md_files/links}"
[[ -f "$FILE" ]] || { notify-send "links" "missing $FILE" >/dev/null 2>&1; exit 1; }

picked=$(cut -d: -f1 "$FILE" | tofi --prompt-text "choose: ")
[[ -n "$picked" ]] || exit 0

# Split on the FIRST colon only: the value is a URL and contains ':' itself.
# The index() prefix match also avoids treating the label as a regex.
url=$(awk -v k="$picked" 'index($0,k ":")==1 {sub(/^[^:]*:[ \t]*/,""); print; exit}' "$FILE")
[[ -n "$url" ]] || exit 0

zen-browser "$url"
