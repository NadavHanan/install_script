#!/usr/bin/env bash
set -e

case $1 in
  up)   brightnessctl -e set 5%+ ;;
  down) brightnessctl -e set 5%- ;;
  *)    echo "usage: brightness up|down" >&2; exit 2 ;;
esac

pct=$((100 * $(brightnessctl get) / $(brightnessctl max)))
WOB_FIFO="${WOB_SOCK:-${XDG_RUNTIME_DIR:-}}/wob.sock"
printf '%s\n' "$pct" > "$WOB_FIFO" 2>/dev/null
