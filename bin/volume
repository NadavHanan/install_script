#!/usr/bin/env bash
set -euo pipefail

SINK="@DEFAULT_AUDIO_SINK@"
case $1 in
    up)   wpctl set-volume -l 1 "$SINK" 5%+ ;;
    down) wpctl set-volume "$SINK" 5%- ;;
    mute) wpctl set-mute "$SINK" toggle ;;
    *)    echo "usage: volume up|down|mute" >&2; exit 2 ;;
esac

pct=$(wpctl get-volume $SINK|awk '{print $2 * 100}')
WOB_FIFO="${WOB_SOCK:-${XDG_RUNTIME_DIR:-}}/wob.sock"
printf '%s\n' "$pct" > "$WOB_FIFO" 2>/dev/null || :
