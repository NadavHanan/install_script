#!/usr/bin/env bash
# volume — pipewire volume control with a wob OSD.
# Args: up | down | mute   (default: up)
set -euo pipefail

SINK="@DEFAULT_AUDIO_SINK@"
SOURCE="@DEFAULT_AUDIO_SOURCE@"
case "${1:-up}" in
    up)      wpctl set-volume -l 1 "$SINK" 5%+ ;;
    down)    wpctl set-volume "$SINK" 5%- ;;
    mute)    wpctl set-mute "$SINK" toggle ;;
    micmute) wpctl set-mute "$SOURCE" toggle ;;
    *)       echo "usage: volume up|down|mute|micmute" >&2; exit 2 ;;
esac

# Show current volume on the wob bar (no-op if wob socket isn't up).
# Mic mute doesn't move the sink, so skip the OSD for it.
[[ "${1:-up}" == micmute ]] && exit 0
pct=$(wpctl get-volume "$SINK" | awk '{printf "%d\n", $2*100}')
wpctl get-volume "$SINK" | grep -q MUTED && pct=0

WOB_FIFO="${WOB_SOCK:-${XDG_RUNTIME_DIR:-}/wob.sock}"
if [[ -p "$WOB_FIFO" ]]; then
    printf '%s\n' "$pct" > "$WOB_FIFO" 2>/dev/null || :
fi
