#!/usr/bin/env bash
# tofi passmenu: pick a pass entry, copy it to the clipboard.
# Enter copies the password. Pass "user" to copy the login line instead.
set -euo pipefail

STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
[[ -d "$STORE" ]] || exit 0

mapfile -t entries < <(find "$STORE" -name '*.gpg' \
    | sed "s|^$STORE/||; s|\.gpg$||")

((${#entries[@]})) || exit 0

picked=$(printf '%s\n' "${entries[@]}" | tofi --prompt "pass > ")
[[ -z "$picked" ]] && exit 0

# ponytail: copied secrets stay in cliphist's history until it ages out;
# proper fix is filtering in the cliphist-store watcher.
copy_secret() {  # copy to both selections, wipe them after 45s (pass convention)
    printf '%s' "$1" | wl-copy
    printf '%s' "$1" | wl-copy --primary
    ( sleep 45; wl-copy -c; wl-copy -pc ) &
}

if [[ "${1:-}" == "user" ]]; then
    copy_secret "$(pass show "$picked" | awk '/^login:/ {print $2; exit}')"
else
    copy_secret "$(pass show "$picked")"
fi
