#!/usr/bin/env bash
# Install a curated set of Hebrew-capable Google Fonts into /usr/share/fonts.
#
# Sparse git clone of google/fonts — only the listed families are downloaded,
# not the whole multi-GB repo. Idempotent; safe to re-run. Runs during setup
# (from install/all.sh, repo bind-mounted in the chroot) and on demand.
set -euo pipefail

FAMILIES=(heebo notosanshebrew assistant frankruhllibre rubik davidlibre
          notoserifhebrew alef ibmplexsanshebrew miriamlibre arimo
          varelaround tinos bonanova suezone)

dest=/usr/share/fonts/truetype/google-fonts/hebrew

# --- elevate to root if needed (on-demand use on the installed system) ----
if (( EUID != 0 )); then
    command -v sudo >/dev/null 2>&1 || { echo "need root (or sudo) to install fonts" >&2; exit 1; }
    exec sudo "$0" "$@"
fi

# Already installed? Stop here — no network, no refetch.
if find "$dest" -maxdepth 1 -iname '*.ttf' 2>/dev/null | grep -q .; then
    echo "Hebrew Google fonts already present in $dest"
    fc-cache -f >/dev/null
    exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# --- clone google/fonts without fetching any blobs yet -------------------
git clone --quiet --depth 1 --filter=blob:none --sparse \
    https://github.com/google/fonts.git "$work/fonts"

# --- pull only the families we want (fetches their font files) -----------
cd "$work/fonts"
sparse_set=()
for f in "${FAMILIES[@]}"; do
    sparse_set+=("ofl/$f")
done
git sparse-checkout set --no-cone "${sparse_set[@]}"

# --- install every font file from those families -------------------------
mkdir -p "$dest"
find "$work/fonts" -type f \( -iname '*.ttf' -o -iname '*.otf' \) \
    -exec install -D -m644 -t "$dest" {} +
fc-cache -f >/dev/null
echo "Done. Hebrew fonts installed to $dest"
