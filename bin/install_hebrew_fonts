#!/usr/bin/env bash
# Install Google Font families that carry a Hebrew subset into /usr/share/fonts.
#
# Fetches the google/fonts repo archive once, but only extracts the small
# per-family METADATA.pb files to discover which families have Hebrew, then
# extracts just those families' .ttf files. Much cheaper than expanding the
# whole (multi-GB) tree. Idempotent; safe to re-run.
#
# Needs curl (or wget). Runs as root (re-execs via sudo otherwise).
set -euo pipefail

# --- elevate to root if needed ------------------------------------------
if (( EUID != 0 )); then
    command -v sudo >/dev/null 2>&1 || { echo "need root (or sudo) to install fonts" >&2; exit 1; }
    exec sudo "$0" "$@"
fi

url="https://github.com/google/fonts/archive/main.tar.gz"
dest="/usr/share/fonts/truetype/google-fonts/hebrew"

# Already installed (e.g. you ran this once, or copied the set over)? Stop
# right here — no network, no flaky giant tarball fetch. This is the "run it
# locally" path.
if find "$dest" -maxdepth 1 -iname '*.ttf' 2>/dev/null | grep -q .; then
    echo "Hebrew Google fonts already present in $dest; latest fonts unchanged."
    fc-cache -f >/dev/null
    exit 0
fi

# --- pick a downloader (only reached when fonts are missing) -----------------
if command -v curl >/dev/null 2>&1; then
    GET=(curl -fSL --retry 3 --retry-delay 2)
elif command -v wget >/dev/null 2>&1; then
    GET=(wget -qO-)
else
    echo "install_hebrew_fonts: need curl or wget" >&2; exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "> downloading Google Fonts archive (metadata scan)..."
"${GET[@]}" "$url" > "$tmp/fonts.tar.gz"

echo "> scanning METADATA.pb for Hebrew subsets..."
mkdir -p "$tmp/meta"
tar -xzf "$tmp/fonts.tar.gz" -C "$tmp/meta" '*/METADATA.pb'

mapfile -t hebrew < <(
    find "$tmp/meta" -name METADATA.pb | while read -r md; do
        grep -q 'subsets: "hebrew"' "$md" && dirname "$md"
    done
)

if (( ${#hebrew[@]} == 0 )); then
    echo "no Hebrew fonts found (archive layout changed?)" >&2
    exit 1
fi

echo "> installing ${#hebrew[@]} font families to $dest"
mkdir -p "$dest"
for d in "${hebrew[@]}"; do
    rel=${d#"$tmp/meta/"}
    tar -xzf "$tmp/fonts.tar.gz" -C "$tmp/meta" \
        --wildcards "$rel/*.ttf" "$rel/*/*.ttf" 2>/dev/null || true
    find "$d" -iname '*.ttf' -exec install -D -m644 -t "$dest" {} +
done

echo "> refreshing font cache..."
fc-cache -f >/dev/null
echo "Done. Hebrew fonts installed to $dest"
